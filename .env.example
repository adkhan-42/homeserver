# ---- Copy to .env and adjust ----

# Timezone (tz database name)
TZ=Asia/Dubai

# User/group that owns the media + config files. `id` on the server shows yours.
PUID=1000
PGID=1000

# App configs/databases (put on the SSD)
APPDATA=/srv/appdata

# Media root. downloads/ and media/ live under here on ONE filesystem.
DATA=/srv/data

# Immich photo/video originals (put on the big disk; this is the irreplaceable stuff)
PHOTOS=/srv/data/photos

# Where Decypharr mounts Real-Debrid. Same path on host and in every container.
DEBRID_MOUNT=/mnt/decypharr

# ---- Backups (restic) ----
# A folder on an external drive, or e.g. b2:bucket-name / s3:... for cloud.
RESTIC_REPOSITORY=/mnt/backup/restic
# File containing the restic repo password. KEEP A COPY OFF THE SERVER.
RESTIC_PASSWORD_FILE=/root/.restic-pass
